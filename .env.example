NEXT_PUBLIC_TURNSTILE_SITE_KEY = ""
TURNSTILE_SECRET_KEY = ""

# -----------------------------------------------------------------------------
# AI text generation provider
# AI_PROVIDER selects the upstream for every text tool:
#   "grsai"   - legacy provider (default)
#   "apimart" - OpenAI-compatible APIMart gateway
# Keep "grsai" until the APIMart compatibility probe passes.
# -----------------------------------------------------------------------------
AI_PROVIDER = "grsai"

# AI Generation with GRSAI (legacy)
GRSAI_API_KEY = ""
GRSAI_BASE_URL = "https://api.grsai.com"

# APIMart (https://docs.apimart.ai)
# Docs: https://docs.apimart.ai/cn/api-reference/texts/general/chat-completions
APIMART_API_KEY = ""
APIMART_BASE_URL = "https://api.apimart.ai"
# /v1 and /api/v1 both exist; streaming keeps /v1 unless the probe says otherwise.
# APIMART_CHAT_PATH = "/v1/chat/completions"
# Enable only after the probe confirms response_format support.
APIMART_SUPPORTS_RESPONSE_FORMAT = "false"
# APIMart reasoning policy. Only reasoning models (gpt-5*) are affected.
# fast keeps thinking ("low") but leaves room for visible text.
# APIMART_REASONING_EFFORT_FAST = "low"
# standard / creative: unset by default -> keep the model's own thinking behavior.
# APIMART_REASONING_EFFORT_STANDARD =
# APIMART_REASONING_EFFORT_CREATIVE =
# Generic fallback for all tiers (leave unset).
# APIMART_REASONING_EFFORT =
# Raise an explicitly-set max_tokens only for fast reasoning models.
# APIMART_REASONING_FAST_MIN_MAX_TOKENS = "4096"
# Non-stream routes use the official stream:false endpoint by default.
# Set to "true" only if the gateway's non-stream queue is too slow.
# AI_NONSTREAM_VIA_STREAM = "false"
# APIMART_CHAT_PATH_NOSTREAM = "/api/v1/chat/completions"

# Optional per-tier model overrides.
# APIMart-scoped values win over the generic AI_MODEL_* keys. This lets an
# APIMart-only model (gpt-5-nano) coexist with a GRSAI fallback.
# APIMart:
APIMART_MODEL_FAST = "gpt-5-nano-2025-08-07"
# APIMART_MODEL_STANDARD = "gemini-2.5-flash-lite"
# APIMART_MODEL_CREATIVE = "gemini-3-flash-preview"
# Generic (applies to both providers; use IDs that exist on the active one):
# AI_MODEL_FAST = "gemini-2.5-flash"
# AI_MODEL_STANDARD = "gemini-3.1-flash-lite"
# AI_MODEL_CREATIVE = "gemini-3-flash"
# AI_TIMEOUT_MS = 180000

# -----------------------------------------------------------------------------
# Model daily free quota (per page, server-side)
# Must be a positive integer; falls back to 3 when unset or invalid
# fast is always unlimited; standard and creative have independent counters
# -----------------------------------------------------------------------------
FREE_STANDARD_DAILY_LIMIT = 3
FREE_CREATIVE_DAILY_LIMIT = 3
# Credits charged per generation after the free quota is exhausted
SG_STANDARD_COST = 3
SG_CREATIVE_COST = 5
# IP-level hard cap shared by all model tiers (defaults to 100)
FREE_IP_DAILY_HARD_CAP = 100
# Set to "false" to hide the ShipAny "Powered by" backlink in the footer
NEXT_PUBLIC_SHOW_POWERED_BY = "false"
